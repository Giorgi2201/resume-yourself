# Copy this file to .env and fill in the required values before running:
#   cp .env.example .env
#
# Then start the stack:
#   docker-compose up --build

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_DB=resume_automation
POSTGRES_USER=resume_user
POSTGRES_PASSWORD=change_me_strong_password

# ── JWT ───────────────────────────────────────────────────────────────────────
# Must be at least 32 characters. Generate with: openssl rand -base64 48
JWT_KEY=replace_with_a_long_random_secret_key_minimum_32_chars

# Optional JWT defaults (these values match appsettings.json defaults)
# JWT_EXPIRY_MINUTES=15
# JWT_REFRESH_EXPIRY_DAYS=14

# ── Frontend ──────────────────────────────────────────────────────────────────
FRONTEND_PORT=80
FRONTEND_ORIGIN=http://localhost
APP_BASE_URL=http://localhost

# ── Email (leave blank to fall back to console logging) ─────────────────────
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=your_app_password
# SMTP_USE_SSL=true
# SMTP_FROM_ADDRESS=you@gmail.com
# SMTP_FROM_NAME=Resume Automation

# ── Initial admin account (set to true on first run only) ────────────────────
# INITIAL_ADMIN_ENABLED=true
# INITIAL_ADMIN_EMAIL=admin@example.com
# INITIAL_ADMIN_PASSWORD=Admin@Password123!
