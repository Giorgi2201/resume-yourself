# ── Build stage ──────────────────────────────────────────────────────────────
FROM node:22-alpine AS build
WORKDIR /app

# Install dependencies (layer-cache friendly — only re-runs when package files change)
COPY package.json package-lock.json ./
RUN npm ci

# Copy source and build in production mode
COPY . .
RUN npx ng build --configuration production

# ── Runtime stage ─────────────────────────────────────────────────────────────
FROM nginx:alpine AS runtime

# Angular 17+ application builder outputs browser bundle to dist/<name>/browser
COPY --from=build /app/dist/resume-automation/browser /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
